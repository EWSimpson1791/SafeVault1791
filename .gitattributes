# Phase-3B: enforce LF line endings repo-wide
# Prevents CRLF corruption in patches, scripts, and CI files on Windows

* text=auto

# Always LF -- never CRLF regardless of OS or editor
*.diff        text eol=lf
*.patch       text eol=lf
*.sh          text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ps1         text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.toml        text eol=lf

# Binary -- no line-ending conversion
*.png         binary
*.jpg         binary
*.gif         binary
*.ico         binary
*.zip         binary
*.exe         binary
