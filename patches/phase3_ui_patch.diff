 """
 Minimal interactive turn loop (human-only version).

 This is the clean Step 4 baseline BEFORE any AI subsystem existed.
 """
+
+from typing import Any
+
+# ------------------------------------------------------------
+# Phase 3B UI Enhancements (safe imports)
+# ------------------------------------------------------------
+try:
+    from ui.console import color_text
+except Exception:
+    def color_text(msg: str, role: str = "info") -> str:
+        return msg
+
+try:
+    from ui.status import format_status
+except Exception:
+    def format_status(game_state: Any, current: str = "") -> str:
+        return f"Status unavailable for {current}"
+
+try:
+    from ui.ascii_map import render_ascii_map
+except Exception:
+    def render_ascii_map(game_state: Any) -> str:
+        return "ASCII map unavailable."
+
+try:
+    from engine.event_log import EventLog
+except Exception:
+    EventLog = None  # type: ignore
+
+
+def _log_event(
+    game_state: Any,
+    turn: int,
+    player: str,
+    event_type: str,
+    desc: str
+) -> None:
+    """Append an event to EventLog if available."""
+    if EventLog is None:
+        return
+
+    try:
+        EventLog(game_state).append({
+            "turn": turn,
+            "player": player,
+            "type": event_type,
+            "desc": desc,
+        })
+    except Exception:
+        pass

